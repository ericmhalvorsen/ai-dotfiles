{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(pnpm run *)",
      "Bash(yarn run *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log --oneline -10)",
      "Read(./package.json)",
      "Read(./README.md)",
      "Read(./AGENTS.md)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Write(./.env*)"
    ]
  },
  
  "model": "claude-sonnet-4-5",
  
  "sandbox": {
    "enabled": true
  },
  
  "hooks": {
    "postEdit": [
      {
        "command": "npm run lint",
        "condition": "test -f package.json"
      },
      {
        "command": "npm run typecheck",
        "condition": "test -f tsconfig.json"
      }
    ]
  }
}
